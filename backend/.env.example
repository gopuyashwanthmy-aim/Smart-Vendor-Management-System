APP_ENV=development
DATABASE_URL=postgresql+psycopg2://smart_vendor:smart_vendor_password@localhost:5432/smart_vendor
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SQLALCHEMY_ECHO=false
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
ENABLE_DEMO_AI=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:8080,http://127.0.0.1:5173
